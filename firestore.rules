rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function belongsToCompany(companyId) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.companyId == userId
        && request.resource.data.role == 'Admin';
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    function hasPeopleRole(companyId) {
      return belongsToCompany(companyId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'HR'];
    }

    match /companies/{companyId} {
      allow create: if signedIn()
        && request.auth.uid == companyId
        && request.resource.data.createdBy == request.auth.uid;
      allow read: if belongsToCompany(companyId);
      allow update: if belongsToCompany(companyId)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    match /employees/{employeeId} {
      allow read: if hasPeopleRole(resource.data.companyId);
      allow create: if hasPeopleRole(request.resource.data.companyId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.employmentStatus == 'Active';
      allow update: if hasPeopleRole(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if hasPeopleRole(resource.data.companyId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
